# Nebula ID 环境配置示例
# 复制此文件为 .env 并填入实际值

# ============================================
# 服务器配置
# ============================================
# HTTP 服务端口（宿主与容器同源；TLS 模式下设为 8443）
APP_HTTP_PORT=8080

# 指标服务端口
APP_METRICS_PORT=9092

# 数据中心 ID (0-7，datacenter_id_bits = 3)
DC_ID=0

# 日志级别: trace, debug, info, warn, error
RUST_LOG=info

# ============================================
# TLS/HTTPS (默认关闭)
# ============================================
# 开启 HTTPS：TLS_ENABLED=true + TLS_HTTP_ENABLED=true + APP_HTTP_PORT=8443
# + HEALTHCHECK_PROTO=https，并把 server.crt/server.key 放入 docker/certs/
# （容器内路径默认 /app/certs/，compose 已挂载）。
TLS_ENABLED=false
TLS_HTTP_ENABLED=false
TLS_GRPC_ENABLED=false
TLS_CERT_PATH=/app/certs/server.crt
TLS_KEY_PATH=/app/certs/server.key
# 可选：自定义 CA（mTLS）
# TLS_CA_PATH=/app/certs/ca.crt
# 健康检查协议（TLS 启用后取 https）
HEALTHCHECK_PROTO=http
# 对外 HTTPS 端口（映射到容器 8443）
APP_HTTPS_PORT=8043

# ============================================
# 数据库配置
# ============================================
# PostgreSQL 密码 - 生产环境必须设置强密码！
# 生成方法：openssl rand -base64 32
POSTGRES_PASSWORD=

# 数据库密码（用于配置文件展开）
# 生成方法：openssl rand -base64 32
NEBULA_DATABASE_PASSWORD=

# 完整数据库 URL（可选，如果设置将覆盖其他数据库配置）
# 格式：postgresql://username:password@host:port/database
# DATABASE_URL=postgresql://idgen:your_password@localhost:5432/idgen

# ============================================
# 安全配置 (生产环境必须设置)
# ============================================

# API Key 盐值 - 警告：生产环境必须设置强随机值！
# 生成方法: openssl rand -hex 32
NEBULA_API_KEY_SALT=

# ============================================
# 开发说明
# ============================================
# 1. 对于本地开发，如果不设置 NEBULA_API_KEY_SALT，
#    Docker 入口脚本会自动生成一个随机值
#
# 2. 对于生产环境，必须设置 NEBULA_API_KEY_SALT：
#    export NEBULA_API_KEY_SALT=$(openssl rand -hex 32)
#
# 3. 运行测试前，设置管理员凭据：
#    export ADMIN_API_KEY_ID="your-admin-key-id"
#    export ADMIN_API_KEY_SECRET="your-admin-key-secret"
